# Copy to .env and fill in. Only EXPO_PUBLIC_ values are bundled into the app; they are public.
# Never put the Supabase service-role key, FCM credentials or any secret in this file.

# Supabase project URL and the public anon (or publishable) key. Protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS project id (needed to obtain Expo push tokens). From `npx eas-cli init`.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Demo mode shows a clearly labelled banner and is refused in production builds. Leave false.
EXPO_PUBLIC_DEMO_MODE=false
